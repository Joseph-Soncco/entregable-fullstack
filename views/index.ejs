<%- include('partials/footer.ejs') %>

<form action="/mangas" method="get" class="row g-2 mb-4">
  
  <div>
    <input type="text" name="busqueda" class="form-control" placeholder="Buscar" value="<%= filtro.busqueda ||  %>">
  </div>

  <div class="col-md-3">
    <select name="categoria" class="form-select">
      <option value="">Categoria</option>
      <% categorias.forEach(c => { %>
        <option value="<%= c.idcategoria %>" <%= filtro.categoria == c.idcategoria? 'selected': '' %>><%= c.nombre %></option>
      <% }) %>
    </select>
  </div>

  <div class="col-md-3">
    <select name="genero" class="form-select">
      <option value="">Género</option>
      <% generos.forEach(g =>{ %>
        <option value="<%= g.idgenero %>" <%= filtro.genero == g.idgenero ? 'selected' : ''%>> <% g.nombre %> </option>
      <% }) %>
    </select>
  </div>

  <div class="col-md-2">
    <select name="orden" class="form-select">
      <option value="">Orden Precio</option>
      <option value="asc" <%= filtro.orden == 'asc' ? 'selected' : '' %>>Menor a Mayor</option>
      <option value="desc" <%= filtro.orden == 'desc' ? 'selected' : '' %>>Mayor a Menor</option>
    </select>
  </div>

  <div class="col-md-1 text-end">
    <button class="btn btn-primary">Buscar</button>
  </div>

</form>

<div class="row">
  <% mangas.forEach(m => { %>
    <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
      <div class="card h-100 shadow-sm">
        <img src="<%= m.imagen||'/img/default-manga.jpg' %>" class="card-img-top" alt="<%= m.titulo %>" style="object-fit:cover;height:200px;">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title"><%= m.titulo %></h5>
          <% if (m.autor) { %><small class="text-muted"><%= m.autor %></small><% } %>
          <p class="mt-2"><strong>S/ <%= Number(m.precio).toFixed(2) %></strong></p>
          <small class="text-secondary mb-2"><%= m.categoria %> · <%= m.genero %></small>
          <div class="mt-auto pt-2">
            <a href="/mangas/edit/<%= m.idmanga %>" class="btn btn-sm btn-info w-100 mb-1">Editar</a>
            <a href="/mangas/delete/<%= m.idmanga %>" class="btn btn-sm btn-danger w-100 delete">Eliminar</a>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/header.ejs') %>