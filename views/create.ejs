<%- include('partials/header') %>
<h2 class="mb-4">Registrar nuevo manga</h2>
<form action="/mangas/create" method="post" enctype="multipart/form-data" class="row g-3">
  <div class="col-md-4">
    <label class="form-label">Título</label>
    <input name="titulo" class="form-control" required/>
  </div>
  <div class="col-md-4">
    <label class="form-label">Autor</label>
    <input name="autor" class="form-control"/>
  </div>
  <div class="col-md-4">
    <label class="form-label">Precio máximo S/. 300</label>
    <input name="precio" type="number" step="0.01" max="300" oninput="if(this.value>300) this.value=300" class="form-control" required/>
  </div>
  <div class="col-md-4">
    <label class="form-label">Categoría</label>
    <select name="idcategoria" class="form-select" required>
      <option value="">Seleccione</option>
      <% categorias.forEach(c => { %><option value="<%= c.idcategoria %>"><%= c.nombre %></option><% }) %>
    </select>
  </div>
  <div class="col-md-4">
    <label class="form-label">Editorial</label>
    <select name="ideditorial" class="form-select" required>
      <option value="">Seleccione</option>
      <% editoriales.forEach(e => { %><option value="<%= e.ideditorial %>"><%= e.nombre %></option><% }) %>
    </select>
  </div>
  <div class="col-md-4">
    <label class="form-label">Género</label>
    <select name="idgenero" class="form-select" required>
      <option value="">Seleccione</option>
      <% generos.forEach(g => { %><option value="<%= g.idgenero %>"><%= g.nombre %></option><% }) %>
    </select>
  </div>
  <div class="col-md-12">
    <label class="form-label">Subir imagen</label>
    <input type="file" id="imagenFile" name="imagenFile" accept="image/*" class="form-control" required/>
  </div>
  <div class="col-md-12">
    <img id="imgPreview" src="/img/default-manga.jpg" alt="Vista previa" class="img-thumbnail mt-2" style="max-height:200px;"/>
  </div>
  <div class="col-12">
    <button class="btn btn-success">Guardar</button>
  </div>
</form>
<script>
  document.getElementById('imagenFile').addEventListener('change', e => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = ev => document.getElementById('imgPreview').src = ev.target.result;
    reader.readAsDataURL(file);
  });
</script>
<%- include('partials/footer') %>
